#
# Containux BusyBox — minimal applet set for the custom /init (GUIDE.md §1).
#
# The host runs no init system: /init is a plain shell script, so only the
# applets it and the runtime scripts use are guaranteed here. Everything
# not listed falls back to BusyBox defaults via olddefconfig. Interactive
# login/getty/editor applets are explicitly disabled — the machine must
# remain completely silent and inaccessible.
#

# ---- Shell ------------------------------------------------------------------
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y

# ---- Core utilities ------------------------------------------------------------
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CLEAR=y
CONFIG_CP=y
CONFIG_CUT=y
CONFIG_DIRNAME=y
CONFIG_ECHO=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_LS=y
CONFIG_MD5SUM=y
CONFIG_MKDIR=y
CONFIG_MKNOD=y
CONFIG_MKTEMP=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_READ=y
CONFIG_READLINK=y
CONFIG_RM=y
CONFIG_SED=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_SYNC=y
CONFIG_TAIL=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_UNAME=y
CONFIG_WHICH=y
CONFIG_AWK=y

# ---- Process & power control ------------------------------------------------
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PS=y
CONFIG_PIDOF=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_HALT=y

# ---- Session plumbing for the first-boot TUI --------------------------------
# "setsid cttyhack <script>" on tty1 gives dialog a controlling terminal.
CONFIG_SETSID=y
CONFIG_CTTYHACK=y

# ---- Module loading ------------------------------------------------------------
# Full modprobe (not MODPROBE_SMALL) so /etc/modprobe.d blacklists work.
CONFIG_MODPROBE=y
# CONFIG_MODPROBE_SMALL is not set
CONFIG_DEPMOD=y
CONFIG_INSMOD=y
CONFIG_LSMOD=y

# ---- Networking ------------------------------------------------------------------
# The macvtap bridge must be created with real iproute2 (busybox's ip applet
# cannot handle "ip link add ... type macvtap"), so the busybox clones stay
# disabled to avoid PATH ambiguity. BR2_PACKAGE_IPROUTE2 provides `ip`.
# CONFIG_IP is not set
# CONFIG_FEATURE_IP_LINK is not set
# CONFIG_FEATURE_IP_ADDRESS is not set
# CONFIG_FEATURE_IP_ROUTE is not set
# CONFIG_IFCONFIG is not set
CONFIG_SYSCTL=y
CONFIG_PING=y

# ---- Misc ---------------------------------------------------------------------------
CONFIG_BLKID=y
CONFIG_DMESG=y
CONFIG_NPROC=y

# ---- Deliberately absent: interactive host access ------------------------------
# No init system, no getty, no login, no editor, no daemons — the host is
# invisible; only the guest exists.
# CONFIG_INIT is not set
# CONFIG_FEATURE_USE_INITTAB is not set
# CONFIG_GETTY is not set
# CONFIG_LOGIN is not set
# CONFIG_SU is not set
# CONFIG_PASSWD is not set
# CONFIG_VI is not set
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
