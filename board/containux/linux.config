#
# Containux host kernel — minimal, silent, single-purpose (x86_64).
#
# The kernel boots a gzip initramfs (linked in via BR2_TARGET_ROOTFS_INITRAMFS),
# runs with "quiet loglevel=0 console=tty3", and must provide exactly what
# the host appliance needs — nothing more:
#
#   * KVM acceleration for QEMU
#   * VFIO/PCIe IOMMU support for GPU passthrough
#   * NVMe + SATA access to the raw guest partition and optical media
#   * USB host controllers + mass storage (NO HID/webcam drivers: the guest
#     owns those devices — usbhid stays a module, uvcvideo is not built)
#   * macvtap for the transparent network bridge
#   * FAT32 to read/write containux.conf on the boot partition
#   * VT/VGA text console for the first-boot TUI on tty1
#
# Unspecified options fall back to their Kconfig defaults via olddefconfig.
#

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_LOCALVERSION="-containux"

# ---- Core runtime (QEMU userspace requirements) ---------------------------
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_AIO=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_SHMEM=y

# ---- Initramfs ------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ---- Device model ----------------------------------------------------------
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set     (PID 1 mounts /dev itself)
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- Networking: transparent macvtap bridge --------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# Common on-board NICs so the primary link is always up before udev settles
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# ---- Storage: raw guest partition + optical media ---------------------------
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# ---- USB: host controllers and mass storage only ----------------------------
# GUIDE.md §4: the host kernel must never claim mice/keyboards/webcams.
# usbhid stays a *module* (blacklisted by default, loaded only during OS
# install for the evdev → PS/2 relay); uvcvideo is deliberately absent.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=m
CONFIG_HID_GENERIC=m
CONFIG_USB_HID=m

# ---- Input: evdev feeds QEMU's emulated PS/2 ports during install -----------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

# ---- KVM acceleration --------------------------------------------------------
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# ---- VFIO PCIe passthrough ----------------------------------------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y

# ---- Power management ----------------------------------------------------------
CONFIG_ACPI=y

# ---- VGA text console for the first-boot TUI (tty1) -----------------------------
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y

# ---- DMI identity (deterministic MAC/SMBIOS-UUID seed, GUIDE.md §5.3) -----------
CONFIG_DMI=y

# ---- FAT32 boot partition --------------------------------------------------------
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---- EFI boot (unified kernel image via systemd-boot/syslinux) --------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ---- RTC & serial (hardware clock, out-of-band debugging) -------------------------
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_SERIAL_8250=y
# Without the console registration, "console=ttyS0" is silently ignored —
# the test harness and field debugging depend on serial output.
CONFIG_SERIAL_8250_CONSOLE=y
