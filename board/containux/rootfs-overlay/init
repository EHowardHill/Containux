#!/bin/sh
#
# Containux — master init (PID 1)
#
# The host boots silently from an initramfs (kernel: "quiet loglevel=0
# console=tty3"), immediately takes over tty1, and exists for one purpose:
# detect the guest-partition state, run the first-boot TUI if the machine
# is empty, then launch a single QEMU/KVM guest configured from
# containux.conf. When the guest powers off, so does the physical machine.
#
# See GUIDE.md §1 (boot), §2 (state detection & TUI), §3 (QEMU mapping),
# §5 (pitfall mitigations: evdev input trap, OOM protection, deterministic
# hardware identity).
#

export PATH="/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin"
export TERM="linux"

BOOT_PART="/dev/nvme0n1p1"       # 100MB FAT32: kernel, initramfs, containux.conf
GUEST_PART="/dev/nvme0n1p2"      # raw partition handed to the guest
BOOT_MNT="/boot"
QMP_SOCK="/tmp/qmp.sock"
HOST_RESERVE_MB=256              # strict host cap: kernel + udev + QEMU overhead

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Progress markers go to the active kernel console. On real hardware that
# is tty3 (out of sight, matching the invisible-boot requirement); when a
# serial console is added to the kernel command line — as tests/run-test.sh
# does with --serial — the markers turn into a full boot trace.
trace() {
    echo "Containux: $*" > /dev/console 2>/dev/null
}

# Probe whether KVM can be used. On real hardware this is trivial (CPU
# flags do not lie), but in emulated test environments every static
# signal is a lie: QEMU's default CPU reports a fake svm flag, kvm_amd
# then loads on it, and even a probe VM keeps running on broken KVM.
# The test harness therefore declares itself with containux.no-kvm on
# the kernel command line; without it, the CPU flags are trusted.
KVM_OK=""
kvm_usable() {
    if [ -z "${KVM_OK}" ]; then
        KVM_OK=0
        if ! tr ' ' '\n' < /proc/cmdline | grep -q '^containux\.no-kvm$'; then
            if [ -e /dev/kvm ] && grep -q -w -e vmx -e svm /proc/cpuinfo; then
                KVM_OK=1
            fi
        fi
    fi
    [ "${KVM_OK}" = 1 ]
}

# Print the first evdev node whose /proc/bus/input/devices block matches the
# given pattern (e.g. "kbd", "mouse"). Used to locate the physical keyboard
# and mouse for the install-time evdev → PS/2 relay (GUIDE.md §5.1).
input_ev() {
    awk -v pat="$1" '
        /^H: Handlers/ { h = $0 }
        /^$/ { if (h ~ pat && h ~ /event[0-9]/) { print h; exit } h = "" }
    ' /proc/bus/input/devices 2>/dev/null | grep -o 'event[0-9]*' | head -n 1
}

# Record the sysfs busnum/devnum of the USB stick behind /dev/sda so the
# udev→QMP pipeline can skip it (it is mapped as a guest block device).
record_install_stick() {
    SDIR=$(readlink -f /sys/block/sda 2>/dev/null)
    [ -n "${SDIR}" ] || return 1
    UDEV_DIR=$(dirname "${SDIR%/block/sda}")
    [ -f "${UDEV_DIR}/busnum" ] || return 1
    echo "$(cat "${UDEV_DIR}/busnum") $(cat "${UDEV_DIR}/devnum")" \
        > /tmp/containux-install-stick
}

# An empty optical drive still registers /dev/sr0; only a tray with media
# that can actually be read counts as installation media.
cdrom_has_media() {
    dd if=/dev/sr0 bs=1 count=1 >/dev/null 2>&1
}

# /dev/sda present and physically on the USB bus?
usb_stick_present() {
    [ -b /dev/sda ] || return 1
    case "$(readlink -f /sys/block/sda 2>/dev/null)" in
        */usb*) return 0 ;;
    esac
    return 1
}

# Launch QEMU with the global ${QEMU_ARGS}. Returns 0 once the QMP socket is
# up (i.e. the machine model was built successfully); kills and fails the
# process otherwise so the caller can fall back.
start_qemu() {
    rm -f "${QMP_SOCK}"
    # QEMU diagnostics go to the active kernel console: invisible on real
    # hardware (console=tty3), but captured by the test harness when it
    # appends console=ttyS0.
    qemu-system-x86_64 ${QEMU_ARGS} 2>>/dev/console &
    QEMU_PID=$!
    i=0
    while [ ${i} -lt 100 ]; do
        [ -S "${QMP_SOCK}" ] && break
        kill -0 "${QEMU_PID}" 2>/dev/null || break
        sleep 0.1
        i=$((i + 1))
    done
    # The QMP socket appears early in QEMU's startup; make sure the machine
    # model is fully past initialization before declaring success.
    if [ -S "${QMP_SOCK}" ]; then
        sleep 2
        kill -0 "${QEMU_PID}" 2>/dev/null && return 0
    fi
    kill "${QEMU_PID}" 2>/dev/null
    wait "${QEMU_PID}" 2>/dev/null
    return 1
}

# ---------------------------------------------------------------------------
# Stage 1 — early userspace (GUIDE.md §1: silent boot, host owns tty1)
# ---------------------------------------------------------------------------

mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /proc /sys /tmp /run /run/udev "${BOOT_MNT}"
mount -t proc   proc   /proc
mount -t sysfs  sysfs  /sys
mount -t tmpfs  tmpfs  /run
mount -t devpts devpts /dev/pts
mount -t tmpfs  tmpfs  /dev/shm

# Take tty1 as our stdio for the TUI; the kernel console is on tty3.
if [ -c /dev/tty1 ]; then
    exec 0</dev/tty1 1>/dev/tty1 2>&1
fi
# Wipe SeaBIOS's output from the visible console. The escape sequence is
# written straight to the device so the cleanup does not depend on where
# this shell's stdio happens to point.
printf '\033[H\033[2J\033[3J' > /dev/tty1 2>/dev/null

# ---------------------------------------------------------------------------
# Stage 2 — hardware discovery (eudev) and OOM protection (GUIDE.md §5.2)
# ---------------------------------------------------------------------------

# All device drivers except HID are built into the kernel, so a plain
# trigger is enough — no early coldplug module dance required.
udevd --daemon 2>/dev/null
udevadm trigger --action=add 2>/dev/null
udevadm settle --timeout=10 2>/dev/null

# Guest RAM is locked by preallocation; the host must never OOM-kill QEMU.
# Strict overcommit (mode 2) is required for that, but its default
# overcommit_ratio of 50% caps CommitLimit at half of RAM — less than the
# guest itself asks for, so the inner QEMU allocation would always fail.
# A ratio of 200 keeps the ceiling at 2x RAM: unbounded overcommit stays
# impossible, while the preallocated guest plus QEMU's translation and
# runtime overhead always fit.
sysctl -w vm.overcommit_memory=2 >/dev/null 2>&1
sysctl -w vm.overcommit_ratio=200 >/dev/null 2>&1
# Report any process that receives a fatal signal (segfault etc.) on the
# kernel console — the only way to see why a userspace tool died on a
# silent, single-purpose appliance.
sysctl -w kernel.print-fatal-signals=1 >/dev/null 2>&1

# ---------------------------------------------------------------------------
# Stage 3 — state detection (GUIDE.md §2.1)
# ---------------------------------------------------------------------------

# Guest memory: everything except the host reserve. With KVM the
# hypervisor overhead is small and fixed, so the host keeps exactly
# 256 MB (GUIDE.md §1) and the guest gets the rest. Without KVM, QEMU
# falls back to TCG, whose translation buffers and device overhead add
# up to roughly 70% on top of the guest's own memory — a flat or small
# reserve lets the kernel OOM-kill the machine, so half of RAM is
# reserved on the fallback path instead.
TOTAL_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
if ! kvm_usable; then
    TCG_RESERVE_MB=$(( TOTAL_KB / 1024 / 2 ))
    [ "${TCG_RESERVE_MB}" -gt "${HOST_RESERVE_MB}" ] && HOST_RESERVE_MB="${TCG_RESERVE_MB}"
    trace "no KVM: TCG fallback, reserving ${HOST_RESERVE_MB} MB for the host"
fi
GUEST_MB=$(( TOTAL_KB / 1024 - HOST_RESERVE_MB ))
[ "${GUEST_MB}" -lt 128 ] && GUEST_MB=128

# blkid against the guest partition decides Installed vs Empty (GUIDE.md
# §2.1). Careful: busybox blkid exits 0 even when no signature is found, so
# the decision must be based on its output, not its status.
INSTALLED=0
if [ -n "$(blkid "${GUEST_PART}" 2>/dev/null)" ]; then
    INSTALLED=1
fi

# Installation media present at boot? (GUIDE.md §3.1)
CDROM=0
USBMEDIA=0
if [ -b /dev/sr0 ] && cdrom_has_media; then
    CDROM=1
fi
usb_stick_present && USBMEDIA=1
MEDIA=0
[ "${CDROM}" = 1 ] || [ "${USBMEDIA}" = 1 ] && MEDIA=1

# Input-trap mitigation (GUIDE.md §5.1): while the system is unconfigured or
# booting from install media, the guest cannot trust its own USB stack yet —
# HID stays on the host and is relayed to QEMU's emulated PS/2 ports through
# evdev instead of blind USB passthrough.
INSTALL_MODE=0
if [ "${MEDIA}" = 1 ] || [ "${INSTALLED}" = 0 ]; then
    INSTALL_MODE=1
fi
trace "state: installed=${INSTALLED} cdrom=${CDROM} usb=${USBMEDIA} guest_mem_mb=${GUEST_MB} install_mode=${INSTALL_MODE}"

# ---------------------------------------------------------------------------
# Stage 4 — load or create containux.conf (GUIDE.md §2.2)
# ---------------------------------------------------------------------------

mount -t vfat -o ro "${BOOT_PART}" "${BOOT_MNT}" 2>/dev/null

if [ "${INSTALLED}" = 0 ]; then
    # Empty machine: hand tty1 to the first-boot TUI. The inner shell must
    # open tty1 itself as a session leader — that claims it as the
    # controlling terminal (busybox's documented pattern). cttyhack would
    # clobber stdio with the kernel's *active* console instead: the serial
    # line during serial test runs, or the invisible tty3 in production.
    trace "first boot: launching first-boot TUI on tty1"
    umount "${BOOT_MNT}" 2>/dev/null
    rm -f /tmp/tui.done /tmp/tui.pid
    setsid sh -c 'exec /usr/local/bin/containux-tui.sh </dev/tty1 >/dev/tty1 2>&1'
    n=0
    while [ ! -f /tmp/tui.done ]; do
        n=$((n + 1))
        if [ -f /tmp/tui.pid ]; then
            # TUI process died abnormally before finishing — carry on with
            # defaults rather than hang the machine forever.
            kill -0 "$(cat /tmp/tui.pid)" 2>/dev/null || break
        elif [ ${n} -gt 30 ]; then
            break
        fi
        sleep 1
    done
    rm -f /tmp/tui.done /tmp/tui.pid
    trace "tui finished: cleaning the visible console"
    # Wipe the TUI's last screen off tty1. Written straight to the device
    # so the cleanup never depends on this shell's stdio redirections.
    printf '\033[H\033[2J\033[3J' > /dev/tty1 2>/dev/null
    mount -t vfat -o ro "${BOOT_PART}" "${BOOT_MNT}" 2>/dev/null
fi

if [ -f /tmp/containux.conf ]; then
    . /tmp/containux.conf
elif [ -f "${BOOT_MNT}/containux.conf" ]; then
    . "${BOOT_MNT}/containux.conf"
fi
umount "${BOOT_MNT}" 2>/dev/null

: "${TARGET_OS:=xp}"
: "${GRAPHICS:=qxl}"
: "${AUDIO:=ac97}"
trace "conf: os=${TARGET_OS} graphics=${GRAPHICS} audio=${AUDIO} mac=${MAC:-<generated>} uuid=${UUID:+ok}"

# Deterministic hardware identity (GUIDE.md §5.3). containux.conf normally
# carries the MAC/SMBIOS UUID generated on first boot; regenerate from the
# motherboard only if the file was somehow lost.
if [ -z "${MAC}" ] || [ -z "${UUID}" ]; then
    H=$(md5sum /sys/class/dmi/id/product_uuid 2>/dev/null | cut -d' ' -f1)
    [ -n "${H}" ] || H=$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-')
    MAC="52:54:00:$(printf '%s' "${H}" | cut -c1-2):$(printf '%s' "${H}" | cut -c3-4):$(printf '%s' "${H}" | cut -c5-6)"
    UUID="$(printf '%s' "${H}" | cut -c1-8)-$(printf '%s' "${H}" | cut -c9-12)-$(printf '%s' "${H}" | cut -c13-16)-$(printf '%s' "${H}" | cut -c17-20)-$(printf '%s' "${H}" | cut -c21-32)"
fi

# ---------------------------------------------------------------------------
# Stage 5 — install-mode input plumbing (GUIDE.md §5.1)
# ---------------------------------------------------------------------------

KBD_EVENT=""
MOUSE_EVENT=""
if [ "${INSTALL_MODE}" = 1 ]; then
    # Lift the usbhid blacklist for this session only: the host needs to read
    # the primary keyboard/mouse and relay them to the emulated PS/2 ports.
    # Once the OS is installed, the blacklist stays in force and every USB
    # device is passed blind to the guest instead.
    rm -f /etc/modprobe.d/containux.conf
    modprobe hid 2>/dev/null
    modprobe hid-generic 2>/dev/null
    modprobe usbhid 2>/dev/null
    sleep 1

    KBD_EVENT=$(input_ev 'kbd')
    [ -n "${KBD_EVENT}" ] || KBD_EVENT=$(input_ev 'eyboard')
    MOUSE_EVENT=$(input_ev 'mouse')
    [ -n "${MOUSE_EVENT}" ] || MOUSE_EVENT=$(input_ev 'ouse')

    # Flags consumed by usb-hotplug.sh for the whole session.
    touch /tmp/containux-install-mode
    [ "${USBMEDIA}" = 1 ] && record_install_stick
fi

# ---------------------------------------------------------------------------
# Stage 6 — transparent network bridge (GUIDE.md §3.2)
# ---------------------------------------------------------------------------

PRIMARY_NIC=$(ls /sys/class/net 2>/dev/null | grep -v -e '^lo$' -e '^macvtap' | head -n 1)
[ -n "${PRIMARY_NIC}" ] || PRIMARY_NIC="eth0"
ip link set "${PRIMARY_NIC}" up 2>/dev/null

# Optional debug address for the host itself (kernel cmdline parameter
# containux.debugnet=<ip>/<prefix>, set e.g. by tests/run-test.sh). The
# appliance normally stays unaddressed — only the guest is bridged onto
# the primary NIC — but with an address the inner guest's VNC server
# becomes reachable through the uplink, which makes lab testing possible.
DEBUGNET=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^containux\.debugnet=//p')
if [ -n "${DEBUGNET}" ]; then
    ip addr add "${DEBUGNET}" dev "${PRIMARY_NIC}" 2>/dev/null
fi

ip link add link "${PRIMARY_NIC}" name macvtap0 type macvtap mode bridge 2>/dev/null
ip link set macvtap0 up 2>/dev/null

# Open the macvtap character device as fd 3 and let QEMU inherit it
# (-netdev tap,fd=3). Node naming varies by kernel: /dev/tapN or /dev/macvtapN.
TAP_IDX=$(cat /sys/class/net/macvtap0/ifindex 2>/dev/null)
TAP_NODE="/dev/tap${TAP_IDX}"
[ -c "${TAP_NODE}" ] || TAP_NODE="/dev/macvtap${TAP_IDX}"
if [ ! -c "${TAP_NODE}" ]; then
    TAP_NODE=$(ls /dev/macvtap* /dev/tap[0-9]* 2>/dev/null | head -n 1)
fi

NET_ARGS="-nic none"
if [ -n "${TAP_NODE}" ] && [ -c "${TAP_NODE}" ]; then
    exec 3<>"${TAP_NODE}"
    NET_ARGS="-netdev tap,fd=3,id=hostnet0 -device e1000,netdev=hostnet0,mac=${MAC}"
fi
trace "net: nic=${PRIMARY_NIC} tap=${TAP_NODE:-none} debugnet=${DEBUGNET:-none}"

# ---------------------------------------------------------------------------
# Stage 7 — virtual motherboard options (GUIDE.md §2.2, §3, §5.3)
# ---------------------------------------------------------------------------

# Graphics: default qxl (headless, VNC served on all interfaces so the
# containux.debugnet path — or a physical network — can reach it), or bind
# the PCIe GPU to vfio-pci and pass it through raw.
VGA_ARGS="-vga qxl -vnc 0.0.0.0:0"
if [ "${GRAPHICS}" = "vfio" ]; then
    GPU_BDF=""
    for d in /sys/bus/pci/devices/*; do
        case "$(cat "${d}/class" 2>/dev/null)" in
            0x0300*|0x0302*) GPU_BDF="${d##*/}"; break ;;
        esac
    done
    if [ -n "${GPU_BDF}" ]; then
        echo "vfio-pci" > "/sys/bus/pci/devices/${GPU_BDF}/driver_override" 2>/dev/null
        echo "${GPU_BDF}" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null
        VGA_ARGS="-vga none -device vfio-pci,host=${GPU_BDF}"
    fi
fi
# Relative-pointer tablet helps VNC cursor tracking once the guest has HID
# drivers; skipped during install (pre-driver installers only grok PS/2).
if [ "${GRAPHICS}" = "qxl" ] && [ "${INSTALL_MODE}" = 0 ]; then
    VGA_ARGS="${VGA_ARGS} -device usb-tablet"
fi

# Audio: AC97 for XP, Intel HDA for Vista/7 (GUIDE.md §2.2).
AUDIO_ARGS="-device AC97"
if [ "${AUDIO}" = "hda" ]; then
    AUDIO_ARGS="-device intel-hda -device hda-duplex"
fi

# ---------------------------------------------------------------------------
# Stage 8 — installation media (GUIDE.md §3.1)
# ---------------------------------------------------------------------------

if [ "${INSTALL_MODE}" = 1 ] && [ "${MEDIA}" = 0 ]; then
    # First boot without media yet: wait on tty1 until the user inserts the
    # installation CD/DVD or a bootable USB stick, then map it below.
    echo "Containux: insert your operating system installation media now..."
    while :; do
        if [ -b /dev/sr0 ] && cdrom_has_media; then
            CDROM=1
            break
        fi
        if usb_stick_present; then
            USBMEDIA=1
            break
        fi
        sleep 2
    done
    MEDIA=1
    echo "Containux: booting the installation environment..."
    sleep 2
    [ "${USBMEDIA}" = 1 ] && record_install_stick
fi

# Boot from the installer CD before the (blank) guest disk.
BOOT_ARGS=""
if [ "${INSTALL_MODE}" = 1 ] && [ "${CDROM}" = 1 ]; then
    BOOT_ARGS="-boot order=dc"
fi

# ---------------------------------------------------------------------------
# Stage 9 — launch the guest (GUIDE.md §3)
# ---------------------------------------------------------------------------

SMP=$(grep -c '^processor' /proc/cpuinfo)
[ "${SMP}" -lt 1 ] && SMP=1

# KVM when the CPU/kernel actually supports it (probed above — the mere
# presence of /dev/kvm is not proof), TCG as a functional fallback.
ACCEL_ARGS="-accel tcg"
if kvm_usable; then
    ACCEL_ARGS="-enable-kvm"
fi

# Install-mode input: relay the physical keyboard/mouse through evdev onto
# QEMU's emulated PS/2 ports (GUIDE.md §5.1).
INPUT_ARGS=""
if [ "${INSTALL_MODE}" = 1 ]; then
    if [ -n "${KBD_EVENT}" ] && [ -e "/dev/input/${KBD_EVENT}" ]; then
        INPUT_ARGS="${INPUT_ARGS} -object input-linux,id=kbd,evdev=/dev/input/${KBD_EVENT}"
    fi
    if [ -n "${MOUSE_EVENT}" ] && [ -e "/dev/input/${MOUSE_EVENT}" ]; then
        INPUT_ARGS="${INPUT_ARGS} -object input-linux,id=mouse,evdev=/dev/input/${MOUSE_EVENT}"
    fi
fi

build_qemu_args() {
    QEMU_ARGS="
        ${ACCEL_ARGS}
        -machine pc
        -uuid ${UUID}
        -m ${GUEST_MB} -mem-prealloc
        -smp ${SMP}
        -rtc base=localtime
        -global PIIX4_PM.disable_s3=1
        -device usb-ehci,id=ehci
        ${VGA_ARGS}
        -display none
        ${AUDIO_ARGS}
        -drive file=${GUEST_PART},format=raw,if=ide,cache=none,${AIO_ARG}
        ${DRIVE_EXTRA_ARGS}
        ${INPUT_ARGS}
        ${NET_ARGS}
        -qmp unix:${QMP_SOCK},server,nowait
        ${BOOT_ARGS}
    "
}

# Storage (GUIDE.md §3.1): the raw guest partition rides legacy IDE for
# period-accurate compatibility, with direct I/O so the host page cache
# never duplicates the guest's work. Optical media and bootable USB install
# media are mapped when present; the USB stick only during install mode
# (otherwise it is passed to the guest blind like every other USB device).
DRIVE_EXTRA_ARGS=""
if [ "${CDROM}" = 1 ]; then
    DRIVE_EXTRA_ARGS="${DRIVE_EXTRA_ARGS} -drive file=/dev/sr0,media=cdrom,if=ide"
fi
if [ "${INSTALL_MODE}" = 1 ] && [ "${USBMEDIA}" = 1 ]; then
    DRIVE_EXTRA_ARGS="${DRIVE_EXTRA_ARGS} -drive file=/dev/sda,format=raw,if=none,id=usbdrive -device usb-storage,drive=usbdrive"
fi

# GUIDE.md §3.1 specifies aio=native; Buildroot's QEMU ships without
# linux-aio, so try native first and silently fall back to threaded AIO.
AIO_ARG="aio=native"
build_qemu_args
if ! start_qemu; then
    AIO_ARG="aio=threads"
    build_qemu_args
    if ! start_qemu; then
        # The machine model could not be built at all — nothing to show.
        trace "guest machine failed to start; powering off"
        echo "Containux: guest machine failed to start; powering off." > /dev/console 2>/dev/null
        sleep 2
        poweroff -f
    fi
fi
trace "guest machine started (pid ${QEMU_PID}, ${GUEST_MB} MB)"

# Devices that were already present at boot fired their udev "add" events
# before QEMU existed. Replay them now that the QMP socket is up, so every
# physical USB device appears in the guest immediately (GUIDE.md §4).
udevadm trigger --action=add --subsystem-match=usb 2>/dev/null

# ---------------------------------------------------------------------------
# Stage 10 — lifecycle (GUIDE.md §3.3)
# ---------------------------------------------------------------------------
# A guest reboot is handled internally by QEMU's virtual motherboard and
# never reaches this point. Reaching here means the guest powered off:
# power down the physical machine exactly like real hardware would.
wait "${QEMU_PID}"
sync
poweroff -f
